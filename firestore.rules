rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidQuizResult(data) {
      return data.keys().hasAll([
        'userId',
        'studentClass',
        'studentNumber',
        'studentName',
        'score',
        'totalQuestions',
        'answers',
        'wrongQuestions',
        'submittedAt'
      ])
      && data.keys().hasOnly([
        'userId',
        'studentClass',
        'studentNumber',
        'studentName',
        'score',
        'totalQuestions',
        'answers',
        'wrongQuestions',
        'submittedAt'
      ])
      && data.userId is string && data.userId == request.auth.uid
      && data.studentClass is string && data.studentClass.size() > 0 && data.studentClass.size() <= 50
      && data.studentNumber is string && data.studentNumber.size() > 0 && data.studentNumber.size() <= 20
      && data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 50
      && data.score is number && data.score >= 0 && data.score <= 100
      && data.totalQuestions is number && data.totalQuestions == 5
      && data.answers is list && data.answers.size() == 5
      && data.wrongQuestions is list && data.wrongQuestions.size() <= 5
      && data.submittedAt is string && data.submittedAt.size() <= 100;
    }

    // Quiz results collection
    // Logged in (anonymous) users can read results and submit their own quiz result
    match /quiz_results/{resultId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(resultId) && isValidQuizResult(incoming());
      allow update, delete: if false;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }
  }
}
